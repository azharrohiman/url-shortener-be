# direnv: load the local .env into the shell on `cd` into this directory.
#
# This is what makes `psql "postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@..."`
# work without you retyping credentials. Docker Compose reads .env directly and
# does not depend on this file.
#
# Run `direnv allow` once after cloning (and again whenever this file changes).
#
# _if_exists: don't error on a fresh clone before `cp .env.example .env`.
dotenv_if_exists .env
