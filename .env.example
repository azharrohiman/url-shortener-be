# Template for the local .env file. Copy it, then fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored and is the single source of truth for local credentials.
# It is consumed twice:
#   - Docker Compose auto-loads it from this directory (both compose files).
#   - direnv exports it into your shell via .envrc, for `mvn spring-boot:run` and `psql`.
#
# The compose files declare these as REQUIRED (${VAR:?}), so `docker compose up`
# fails fast with a clear message if .env is missing rather than starting a
# half-configured database.

POSTGRES_DB=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=change-me
